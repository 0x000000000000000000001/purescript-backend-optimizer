--- src/PureScript/Backend/Optimizer/Convert.purs
+++ src/PureScript/Backend/Optimizer/Convert.purs
@@ -589,7 +589,17 @@
     ExprCase _ exprs alts -> do
-      exprs' <- traverse convertExpr exprs
+      let 
+        -- Extract types from binders to fix missing types on scrutinees (synthetic vars like v, v1)
+        getBinderType :: Binder Ann -> Maybe ExprType
+        getBinderType b = case binderAnn b of
+          Ann { type: ty } -> Just ty
+        
+        binderTypes = case Array.head alts of
+          Just (CaseAlternative bs _) -> map getBinderType bs
+          Nothing -> map (const Nothing) exprs
+          
+      exprs' <- traverse (\(Tuple ty mbE) -> do
+        e <- convertExpr mbE
+        pure $ case ty of
+          Just t -> overBackendExpr (\(BackendExpr be) -> BackendExpr be { ann = be.ann { type = t } }) e
+          Nothing -> e
+        ) (Array.zip binderTypes exprs)
